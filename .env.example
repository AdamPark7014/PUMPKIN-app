# =============================================================================
# Boletera / TicketOS — plantilla de entorno local
# =============================================================================
# Uso:
#   1) Copia este archivo a `.env` en la raíz del monorepo
#   2) Sustituye TODOS los valores REPLACE_ME_* (nunca uses secretos reales aquí)
#   3) Infra mínima:        docker compose up -d postgres redis
#   4) Stack completo:      docker compose up -d --build
#   5) Apps con pnpm local: apunta DATABASE_URL/REDIS_URL a los puertos de host
#
# Host vs contenedor:
#   - Este archivo está pensado para procesos en el HOST (pnpm turbo / Nest / Next).
#   - docker-compose.yml sobrescribe DATABASE_URL / REDIS_URL / API_INTERNAL_URL
#     con nombres DNS internos (postgres, redis, api) dentro de la red Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# Variables canónicas (requeridas / núcleo)
# -----------------------------------------------------------------------------

# Prisma / Postgres — host port 5434 (Windows: 5432/5433 suelen estar ocupados)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/boletera?schema=public
# Misma DB sin pooler (Neon/Supabase/PgBouncer). En local Docker = DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/boletera?schema=public

REDIS_URL=redis://localhost:6379

API_PORT=4000
API_HOST=0.0.0.0
# Origen público del API (navegador / Banorte IPN). Sin barra final.
API_PUBLIC_URL=http://127.0.0.1:4000
# Origen interno (worker → API). En host: localhost; en Compose se fuerza a http://api:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1

# development = Banorte demo permitido, cookies lax, CORS permisivo en LAN
# production  = exige CORS_ORIGIN; Banorte demo BLOQUEADO sin BANORTE_MERCHANT_ID
NODE_ENV=development
LOG_LEVEL=debug

# JWT_SECRET: mínimo 32 bytes; NO puede empezar por change-me|secret|your-super-secret
# (apps/api/src/modules/auth/jwt-secret.ts lo rechaza en boot)
# También actúa de fallback de TICKET_QR_SECRET → ver docs/ENV-SECRETS.md
JWT_SECRET=REPLACE_ME_local_dev_jwt_secret_min_32_bytes_xx
INTERNAL_API_SECRET=REPLACE_ME_local_dev_internal_api_secret

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://localhost:3010,http://127.0.0.1:3010

# OpenTelemetry (apps aún sin instrumentación OTEL cableada; endpoint listo para Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=boletera-api

# -----------------------------------------------------------------------------
# Frontends / URLs auxiliares (usadas por app)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
TAQUILLA_URL=http://localhost:3002

# Auth tokens (Nest JWT module)
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d

# TICKET_QR_SECRET: firma HMAC rotativa de los QR de boleto (packages/crypto).
#   - MÍNIMO 32 caracteres. `assertTicketSecret()` lanza si es más corto:
#     "TICKET_QR_SECRET must be at least 32 characters. Generate one with: openssl rand -hex 32"
#   - Genera uno con:  openssl rand -hex 32   (64 caracteres hex)
#   - Si lo dejas SIN definir, la API cae a JWT_SECRET. Ese fallback también debe
#     tener ≥32 caracteres: un JWT_SECRET corto NO se acepta y el QR falla al firmarse
#     o verificarse (500 al emitir/escanear), no al arrancar.
#   - No lo pongas vacío: el comportamiento del valor vacío difiere entre módulos.
#   Detalle completo: docs/ENV-SECRETS.md
TICKET_QR_SECRET=REPLACE_ME_ticket_qr_secret_use_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# Banorte (Payworks / SPEI / OXXO) — packages/payments + API payments
# Sin BANORTE_MERCHANT_ID = modo DEMO (solo NODE_ENV≠production)
# -----------------------------------------------------------------------------
BANORTE_MERCHANT_ID=
BANORTE_AFFILIATION=
BANORTE_TERMINAL=1
BANORTE_USER=
BANORTE_API_SECRET=REPLACE_ME_banorte_api_secret_or_leave_empty
BANORTE_PASSWORD=
BANORTE_ACCOUNT_CLABE=
BANORTE_PAYWORKS_URL=https://eps.banorte.com/secure3d/Solucion3DSecure.htm
BANORTE_QUERY_URL=https://eps.banorte.com/secure3d/consultaTransaccion.htm
BANORTE_WEBHOOK_SECRET=REPLACE_ME_banorte_webhook_secret
BANORTE_RETURN_URL=http://localhost:3000
BANORTE_CANCEL_URL=http://localhost:3000
# Alias opcional si no usas API_PUBLIC_URL
BANORTE_API_PUBLIC_URL=

# -----------------------------------------------------------------------------
# PayPal — documentado / reservado (no hay provider activo en packages/payments)
# -----------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=REPLACE_ME_paypal_client_id
PAYPAL_CLIENT_SECRET=REPLACE_ME_paypal_client_secret

# -----------------------------------------------------------------------------
# SMTP / correo — apps/api notification/mail.service.ts
# Vacío = transporte no configurado (reset password / tickets no se envían)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=REPLACE_ME_smtp_password_or_leave_empty
MAIL_FROM=noreply@boletera.local
FRAUD_ALERT_EMAIL=

# -----------------------------------------------------------------------------
# AWS S3 — documentado / reservado (sin cliente S3 cableado en apps/api aún)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_ME_aws_access_key_id
AWS_SECRET_ACCESS_KEY=REPLACE_ME_aws_secret_access_key
AWS_S3_BUCKET=REPLACE_ME_boletera-uploads

# -----------------------------------------------------------------------------
# OAuth SSO Admin — apps/api auth (Google / Microsoft)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_client_secret_or_leave_empty
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=REPLACE_ME_microsoft_client_secret_or_leave_empty
MICROSOFT_TENANT_ID=common
OAUTH_ADMIN_REDIRECT_URI=http://localhost:3001/login/oauth/callback
# Lista CSV opcional; si falta, en development se aceptan redirects localhost
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3001/login/oauth/callback

# -----------------------------------------------------------------------------
# Worker — apps/worker/src/config.ts
# -----------------------------------------------------------------------------
WORKER_HEALTH_PORT=4100
WORKER_AUTO_PAYOUT=false
WORKER_INTERVAL_MS=30000
WORKER_CONCURRENCY=2
WORKER_MAX_IN_FLIGHT=4
WORKER_JOB_ATTEMPTS=5
WORKER_BACKOFF_BASE_MS=2000
WORKER_BACKOFF_MAX_MS=60000
WORKER_INTERNAL_REQUEST_TIMEOUT_MS=15000
WORKER_HEALTH_CHECK_TIMEOUT_MS=2000
WORKER_READINESS_MAX_QUEUE_DEPTH=10000
WORKER_SHUTDOWN_GRACE_MS=25000
WORKER_QUEUE_PREFIX=ticketos
WORKER_QUEUE_NAME=worker-jobs
WORKER_DLQ_NAME=worker-dlq

# -----------------------------------------------------------------------------
# Misc API
# -----------------------------------------------------------------------------
TRUST_PROXY_HOPS=0
# Tenant fijo en localhost. Con el valor explícito, la cartelera local se
# limita a ese tenant (modo evento único). Para Pumpkin Zone: pumpkin-zone
# (siembra con: pnpm --filter @boletera/database exec tsx scripts/seed-pumpkin.ts)
# Local multi-tenant demo. Para Pumpkin Zone en localhost: pumpkin-zone
DEMO_TENANT_SLUG=boletera-plataforma
ENABLE_FRAUD_DETECTION=true
ENABLE_ANALYTICS=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI — documentado / reservado (no referenciado en apps/api runtime)
OPENAI_API_KEY=REPLACE_ME_openai_api_key_or_leave_empty

# -----------------------------------------------------------------------------
# E2E (Playwright) — solo host / CI
# -----------------------------------------------------------------------------
API_URL=http://127.0.0.1:4000/api/v1
E2E_PASSWORD=REPLACE_ME_e2e_password

# ---------------------------------------------------------------------------
# Mercado Pago — Checkout Pro (pasarela online de Pumpkin Zone)
# Con MP_ACCESS_TOKEN presente, las ventas online van a Mercado Pago y Banorte
# queda fuera. Sin él, se mantiene el comportamiento anterior (Banorte/demo).
#   MP_ACCESS_TOKEN   APP_USR-… (producción) o TEST-… (pruebas). Panel MP →
#                     Tus integraciones → Credenciales.
#   MP_WEBHOOK_SECRET Panel MP → Webhooks → Clave secreta. Obligatoria en prod.
#   WEB_PUBLIC_URL    Base pública del storefront (back_urls).
#   API_PUBLIC_URL    Base pública de la API (notification_url).
#   MP_STATEMENT      Texto en el estado de cuenta (≤16 chars).
# Webhook a registrar en MP: {API_PUBLIC_URL}/api/v1/payments/webhooks/mercadopago
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
MP_STATEMENT=PUMPKIN ZONE

# ---------------------------------------------------------------------------
# Cargos sobre el precio. Pumpkin Zone vende a precio final (IVA incluido,
# sin cargo por servicio): ambos en 0. Para cobrar cargos aparte: 0.10 / 0.16
# ---------------------------------------------------------------------------
PRICING_SERVICE_FEE_RATE=0
PRICING_TAX_RATE=0
