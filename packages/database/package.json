{
  "name": "@boletera/database",
  "version": "1.0.0",
  "description": "Prisma database schema and client for Boletera Platform",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "prisma:generate": "prisma generate && node ./scripts/sync-prisma-client.mjs",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx --env-file=.env scripts/seed.ts",
    "prisma:seed:demo": "tsx --env-file=.env scripts/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "prisma:validate": "prisma validate"
  },

  "dependencies": {
    "@boletera/shared": "workspace:*",
    "@boletera/venue-engine": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "@types/node": "^22.10.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}

