{
  "name": "boletera-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade ticketing platform for B2B ticket operations - mega heavy, impeccable, serving all ticketing business models",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.30.3"
  },
  "scripts": {
    "predev": "pnpm db:generate",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:taquilla": "turbo run dev --filter=taquilla",
    "dev:worker": "turbo run dev --filter=worker",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=api",
    "build:admin": "turbo run build --filter=admin",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "format": "pnpm --recursive exec prettier --write .",
    "format:check": "pnpm --recursive exec prettier --check .",
    "db:generate": "pnpm --filter @boletera/database prisma:generate",
    "postinstall": "pnpm db:generate",
    "db:migrate:dev": "pnpm --filter @boletera/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @boletera/database prisma:migrate:deploy",
    "db:seed": "pnpm --filter @boletera/database prisma:seed",
    "db:studio": "pnpm --filter @boletera/database prisma:studio",
    "db:reset": "pnpm --filter @boletera/database prisma:reset",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:list": "playwright test -c e2e/playwright.config.ts --list",
    "test:e2e:typecheck": "pnpm --filter @boletera/admin exec tsc -p ../../e2e/tsconfig.json --noEmit",
    "test:e2e:contracts": "playwright test -c e2e/playwright.config.ts e2e/contracts",
    "test:e2e:security": "playwright test -c e2e/playwright.config.ts e2e/security",
    "test:e2e:quality": "playwright test -c e2e/playwright.config.ts e2e/quality",
    "test:e2e:critical": "playwright test -c e2e/playwright.config.ts e2e/storefront e2e/inventory e2e/operations e2e/security",
    "test:e2e:api": "playwright test -c e2e/playwright.config.ts e2e/contracts e2e/security e2e/inventory e2e/operations",
    "smoke:venue-engine": "pnpm --filter @boletera/venue-engine build && pnpm --filter @boletera/venue-engine smoke",
    "smoke:api": "node apps/api/scripts/smoke-interactive-status.cjs",
    "docker:config": "docker compose config",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --wait postgres redis",
    "docker:up:stack": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "observability:config": "docker compose -f infra/observability/compose.yaml config",
    "observability:up": "docker compose -f infra/observability/compose.yaml up -d --wait",
    "observability:down": "docker compose -f infra/observability/compose.yaml down",
    "bootstrap": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap.ps1 -SkipDev",
    "infra:verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-infra.ps1",
    "ci:verify": "turbo run check-types lint test build"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.3.3",
    "turbo": "^2.9.14"
  }
}
