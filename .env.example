# Database
# Note: In Prisma 7+, DATABASE_URL will be configured via prisma.config.ts adapter
# For now (Prisma 6), use DATABASE_URL environment variable
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boletera?schema=public"
# Optional: Direct connection without pooling (some hosting platforms require this)
# DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boletera?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_HOST=0.0.0.0
# Origen público del API (HTTPS en prod) — usado para URL IPN Banorte en admin
API_PUBLIC_URL=http://127.0.0.1:4000
NODE_ENV=development
LOG_LEVEL=debug

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development

# Admin Panel
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1

# Pagos — Banorte (Payworks / SPEI / OXXO) → cuenta empresarial del promotor
# Sin BANORTE_MERCHANT_ID = modo DEMO (solo desarrollo; bloqueado en NODE_ENV=production)
BANORTE_MERCHANT_ID=
BANORTE_AFFILIATION=
BANORTE_TERMINAL=1
BANORTE_USER=
BANORTE_API_SECRET=
# CLABE Banorte del promotor (requerida para SPEI en vivo)
BANORTE_ACCOUNT_CLABE=
BANORTE_PAYWORKS_URL=https://eps.banorte.com/secure3d/Solucion3DSecure.htm
# Obligatorio en producción (IPN / webhooks)
BANORTE_WEBHOOK_SECRET=
BANORTE_QUERY_URL=https://eps.banorte.com/secure3d/consultaTransaccion.htm
WORKER_AUTO_PAYOUT=false
BANORTE_RETURN_URL=http://localhost:3000
BANORTE_CANCEL_URL=http://localhost:3000
OPENAI_API_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# JWT & Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_EXPIRATION=7d
INTERNAL_API_SECRET=change-me-worker-reconcile-secret
API_INTERNAL_URL=http://localhost:4000/api/v1

# SSO Admin (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
OAUTH_ADMIN_REDIRECT_URI=http://localhost:3001/login/oauth/callback

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@boletera.com
FRAUD_ALERT_EMAIL=
TICKET_QR_SECRET=
API_INTERNAL_URL=http://localhost:4000/api/v1

# Fraud Detection & Analytics
ENABLE_FRAUD_DETECTION=true
ENABLE_ANALYTICS=true

# File Storage (S3 or alternative)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
