# =============================================================================
# Pumpkin Zone — plantilla de secretos de producción
# =============================================================================
# Copiar a /opt/pumpkin/.env (mismo directorio que pumpkin-compose.yml).
# Nunca subir este archivo con valores reales al git.
# Guía de cobro: docs/ACTIVAR-MERCADO-PAGO.md
# =============================================================================

POSTGRES_PASSWORD=REPLACE_ME_long_random
JWT_SECRET=REPLACE_ME_long_random
TICKET_QR_SECRET=REPLACE_ME_long_random
INTERNAL_API_SECRET=REPLACE_ME_long_random

# URLs públicas (sin barra final). API_PUBLIC_URL es la base que ve el navegador
# (mismo host que el storefront; Traefik enruta /api al contenedor api).
WEB_PUBLIC_URL=https://pumpkin.experiencebt.com.mx
API_PUBLIC_URL=https://pumpkin.experiencebt.com.mx
API_INTERNAL_URL=http://api:4000/api/v1

# Mercado Pago Checkout Pro — sin esto, /boletos muestra "abre muy pronto"
PAYMENTS_GATEWAY=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_STATEMENT=PUMPKIN ZONE
# Hold de inventario / orden / voucher OXXO pendientes (horas). Default 24.
MP_PENDING_TTL_HOURS=24

# Precio final (IVA incluido, sin cargo por servicio) — modelo Pumpkin
PRICING_SERVICE_FEE_RATE=0
PRICING_TAX_RATE=0

# Correo de boletos QR (obligatorio para entrega automática post-pago)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente: MAIL_FROM es el canónico; SMTP_FROM se acepta como alias.
# Debe ser un remitente verificado en Brevo.
MAIL_FROM=boletos@pumpkinzone.mx
SMTP_FROM=boletos@pumpkinzone.mx
MAIL_BRAND=Pumpkin Zone
# Clave API Brevo (xkeysib-…). Si está, el API la usa en lugar de SMTP.
BREVO_API_KEY=
