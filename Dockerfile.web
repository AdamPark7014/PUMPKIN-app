# Build stage
FROM node:22-alpine AS builder

WORKDIR /app

# Build argument for app selection (web, admin, or taquilla)
ARG APP_NAME=web

# Copy entire monorepo
COPY . .

# Install dependencies
RUN npm install -g pnpm@10.30.3 && \
    pnpm install --frozen-lockfile

# Build the Next.js app
RUN pnpm run build:${APP_NAME}

# Production stage
FROM node:22-alpine

WORKDIR /app

# Build argument for app selection
ARG APP_NAME=web

# Install pnpm
RUN npm install -g pnpm@10.30.3

# Set environment variables
ENV NODE_ENV=production \
    NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Copy built Next.js app
COPY --from=builder /app/apps/${APP_NAME}/.next ./apps/${APP_NAME}/.next
COPY --from=builder /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public
COPY --from=builder /app/apps/${APP_NAME}/package.json ./apps/${APP_NAME}/package.json
COPY --from=builder /app/node_modules ./node_modules

# Copy root package.json
COPY package.json ./

# Expose port
EXPOSE 3000

# Default port for web app
ENV PORT=3000

# Start the app
CMD ["node", "--max-old-space-size=1024", "apps/${APP_NAME}/node_modules/.bin/next", "start", "--dir", "apps/${APP_NAME}"]
