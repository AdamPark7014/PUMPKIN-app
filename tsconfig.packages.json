{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "composite": false
  },
  "exclude": ["node_modules", "dist", "**/*.js", "**/*.d.ts", "**/*.map"]
}
